# OS
Thumbs.db
.DS_Store

# Node
node_modules/
dist/
*.tsbuildinfo

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins*
app/build/
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/*.iml
# Generated localizations (rebuilt by flutter gen-l10n during pub get/build)
app/lib/l10n/app_localizations*.dart

# Server
server/data/
*.sqlite
*.sqlite-*

# Secrets — never commit
*.keystore
*.jks
service-account*.json
# Firebase client config: not a hard secret (it ships in the APK), but its API
# key is best kept out of git. Dropped in locally; injected in CI from a secret.
app/android/app/google-services.json
app/ios/Runner/GoogleService-Info.plist
.env
.env.*

# E2E throwaway state
extension/.e2e-state.json

# scratch screenshots
docs/screens/tmp.png
docs/screens/chk.png

# Legal drafts — hosted on the website, not tracked in the public repo
legal/
store-assets/
