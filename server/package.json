{
  "name": "twokeys-server",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Purr relay server: E2EE pairing/approval relay and encrypted backup store. Sees only ciphertext.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "google-auth-library": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true
  }
}
